---
import PageLayout from "@/layouts/Base.astro";

const meta = {
  title: "CV",
  description: "Curriculum vitae of Nathan R. González, PhD student in Physics at UC Davis.",
};
---

<PageLayout meta={meta}>
  <div class="cv-header">
    <h1 class="cv-name">Nathan R. González</h1>
    <p class="cv-contact">
      <a href="mailto:nrgonz@ucdavis.edu">nrgonz@ucdavis.edu</a>
      <span class="dot">·</span>
      (808) 364-8151
      <span class="dot">·</span>
      <a href="https://www.linkedin.com/in/nathanrgonzalez" target="_blank" rel="noopener noreferrer">linkedin.com/in/nathanrgonzalez</a>
      <span class="dot">·</span>
      Davis, CA
    </p>
    <!--
      TO ADD A PDF DOWNLOAD BUTTON:
      1. Place your CV PDF at  Page/public/files/gonzalez_cv.pdf
      2. Uncomment the line below:
    -->
    <!-- <a href="/files/gonzalez_cv.pdf" class="dl-btn" download>⬇ Download PDF</a> -->
  </div>

  <!-- ── Education ─────────────────────────────────────── -->
  <section class="cv-section">
    <h2 class="cv-heading">Education</h2>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Doctor of Philosophy in Physics</h3>
          <p class="cv-org">University of California, Davis, CA</p>
        </div>
        <div class="cv-right">
          <span class="cv-date">Fall 2029 (expected)</span>
          <span class="cv-gpa">GPA: 3.56</span>
        </div>
      </div>
      <p class="cv-detail">Advisor: Marina Radulaski</p>
    </div>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Bachelor of Science in Physics <span class="minor">with Minor in Mathematics</span></h3>
          <p class="cv-org">Gordon College, Wenham, MA</p>
        </div>
        <div class="cv-right">
          <span class="cv-date">December 2023</span>
          <span class="cv-gpa">GPA: 3.85</span>
        </div>
      </div>
      <p class="cv-detail"><em>summa cum laude</em></p>
      <p class="cv-detail">
        Honors Thesis: <em>Ultrasound Pulse-Echo Measurements in the Mixed Perovskite Relaxor
        K<sub>1-x</sub>Li<sub>x</sub>TaO<sub>3</sub></em>
      </p>
      <p class="cv-detail">Advisor: Oleskiy V. Svitelskiy</p>
    </div>
  </section>

  <!-- ── Research ──────────────────────────────────────── -->
  <section class="cv-section">
    <h2 class="cv-heading">Research Experience</h2>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Graduate Student Researcher</h3>
          <p class="cv-org">Department of Electrical and Computer Engineering, UC Davis, CA</p>
        </div>
        <span class="cv-date">Aug 2024 – Present</span>
      </div>
      <ul>
        <li>Developing analog quantum simulations based on photonic cavity QED systems to model lattice gauge theories.</li>
        <li>Simulation of open quantum systems using QuTiP to model coupled cavity QED systems.</li>
        <li>Fabrication of 2D photonic crystal cavities in silicon-on-insulator as the experimental platform.</li>
        <li>Fabrication and characterization of nanophotonic devices in silicon and silicon carbide with integrated color centers.</li>
        <li>Cleanroom nanofabrication: photolithography, reactive ion etching, e-beam deposition, chemical vapor deposition, wet etching, sputtering.</li>
        <li>Optical characterization: time-resolved photoemission, cryogenic photoluminescence, cavity and waveguide transmission measurements.</li>
        <li>Fabricating 2D Paul traps for a trapped ion experiment with on-chip integrated photonics (AIM Photonics).</li>
      </ul>
    </div>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Science Undergraduate Laboratory Intern</h3>
          <p class="cv-org">Lawrence Berkeley National Laboratory, Berkeley, CA</p>
        </div>
        <span class="cv-date">Jan – May 2024</span>
      </div>
      <ul>
        <li>Laser frequency stabilization of diode lasers via Pound-Drever-Hall locking with high-finesse and ultra-low expansion cavities.</li>
        <li>Participated in designing and implementing a homemade low-finesse optical reference cavity for PDH locking.</li>
        <li>Designed and implemented compact double-pass acousto-optic modulator optical layout for rack-mounted breadboard system.</li>
        <li>Performed Rabi spectroscopy on a calcium ion in a Paul trap to study decoherence and dephasing.</li>
        <li>Contributed to a full-stack trapped ion quantum application network testbed.</li>
      </ul>
    </div>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Summer Undergraduate Research Fellow</h3>
          <p class="cv-org">National Institute of Standards and Technology, Boulder, CO</p>
        </div>
        <span class="cv-date">May – Aug 2023</span>
      </div>
      <ul>
        <li>Designed and constructed a scheme for optical homodyne tomography to reconstruct quantum states of light.</li>
        <li>Wrote instrument control scripts, data processing algorithms, and a maximum likelihood estimation algorithm in Python to construct density matrices from field quadratures.</li>
        <li>Selected as one of two students to present research during keynote session (25-minute oral presentation, 200+ attendees).</li>
      </ul>
    </div>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Undergraduate Research Assistant</h3>
          <p class="cv-org">Department of Physics, Gordon College, Wenham, MA</p>
        </div>
        <span class="cv-date">Feb 2022 – Dec 2023</span>
      </div>
      <ul>
        <li>Investigated electric properties of novel relaxor ferroelectrics using ultrasound pulse-echo measurements.</li>
        <li>Measured Young's Modulus in K<sub>1-x</sub>Li<sub>x</sub>TaO<sub>3</sub> under varied external electric fields.</li>
        <li>Investigated a unique ferroelectric phase memory effect in KTa<sub>1-x</sub>Nb<sub>x</sub>O<sub>3</sub> at low temperatures.</li>
      </ul>
    </div>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Naval Research Enterprise Intern</h3>
          <p class="cv-org">Naval Research Laboratory, Washington, D.C. (Remote)</p>
        </div>
        <span class="cv-date">Oct – Dec 2022</span>
      </div>
      <ul>
        <li>Independently developed a cross-correlation algorithm for deterministic signal analysis and Arrhenius model simulations in non-linear slow dynamics.</li>
        <li>Contributed to a coda wave interferometry program; improved existing data processing code.</li>
      </ul>
    </div>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>National Science Foundation Summer Research Fellow</h3>
          <p class="cv-org">University of Rhode Island Graduate School of Oceanography, Narragansett, RI</p>
        </div>
        <span class="cv-date">Jun – Aug 2022</span>
      </div>
      <ul>
        <li>Led coastal surveys using unmanned aerial and surface vehicles to collect sonar and photogrammetric data.</li>
        <li>Designed rapid assessment tools for shoreline change including full 3D spatial models from vegetation line to shallow depths.</li>
        <li>Summarized research in a 10-page manuscript and 20-minute oral presentation.</li>
      </ul>
    </div>
  </section>

  <!-- ── Publications ──────────────────────────────────── -->
  <section class="cv-section">
    <h2 class="cv-heading">Publications</h2>
    <ol class="pub-list">
      <li>
        M. Klein, E. Hamdarsi, N. R. Gonzalez, Md. A. Adib, M. Radulaski.
        <em>Quantum simulation with coupled cavity arrays in silicon.</em>
        Manuscript in preparation.
      </li>
      <li>
        N. R. Gonzalez*, T. Budde*, K. Kersic*, Z. Steele, A. H. Rubin, J. C. Pinto Barros,
        M. Radulaski, M. Marinkovic. (*equal contribution)
        <em>Photonic Analog Quantum Simulation of (1+1)-Dimensional U(1) Lattice Gauge Theory
        with Dynamical Matter.</em>
        <a href="https://arxiv.org/abs/2606.02756" target="_blank" rel="noopener noreferrer">arXiv:2606.02756</a> (2026).
      </li>
      <li>
        A. H. Rubin, V. Zalandauskas, P. Saha, R. Poudel, A. Teien, L. Hofmann,
        N. R. Gonzalez, M. E. Bathen, M. Radulaski.
        <em>Seeing the forbidden: overcoming optical selection rules through nanophotonic integration.</em>
        <a href="https://arxiv.org/abs/2605.04277" target="_blank" rel="noopener noreferrer">arXiv:2605.04277</a> (2026).
      </li>
      <li>
        V. A. Norman, S. Majety, A. H. Rubin, P. Saha, N. R. Gonzalez, J. Simo,
        B. Palomarez, L. Li, P. B. Curro, S. Dhuey, S. Virasawmy, M. Radulaski.
        <em>Sub-2 Kelvin Characterization of Nitrogen-Vacancy Centers in Silicon Carbide Nanopillars.</em>
        <a href="https://doi.org/10.1021/acsphotonics.5c00096" target="_blank" rel="noopener noreferrer">ACS Photonics 12(5), 2604–2611 (2025)</a>.
      </li>
    </ol>
  </section>

  <!-- ── Teaching ──────────────────────────────────────── -->
  <section class="cv-section">
    <h2 class="cv-heading">Teaching</h2>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Graduate Student Mentor</h3>
          <p class="cv-org">Radulaski Laboratory, UC Davis, CA</p>
        </div>
        <span class="cv-date">Aug 2024 – Present</span>
      </div>
      <ul>
        <li>Mentoring three undergraduates on all-photonic quantum simulation, open quantum systems, and coupled cavity QED.</li>
        <li>Mentoring four students in design of a circuit QED quantum simulation platform.</li>
      </ul>
    </div>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Teaching Assistant</h3>
          <p class="cv-org">Department of Physics, UC Davis, CA</p>
        </div>
        <span class="cv-date">Sep 2024 – Present</span>
      </div>
      <ul>
        <li>PHY 45 Computational Physics — 1 quarter (~50 students). Office hours, lab sections, grading.</li>
        <li>PHY 7A/7B/7C Introductory Physics (Biological Sciences) — 5 quarters (30–70 students). Office hours, quiz prep, homework grading, exam review.</li>
      </ul>
    </div>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Teaching Assistant</h3>
          <p class="cv-org">Department of Physics, Gordon College, Wenham, MA</p>
        </div>
        <span class="cv-date">Aug 2022 – Dec 2023</span>
      </div>
      <ul>
        <li>Introductory physics labs — 3 semesters (~30 students). Grading, exam proctoring, lab manual development.</li>
      </ul>
    </div>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Tutor</h3>
          <p class="cv-org">Academic Success Center, Gordon College, Wenham, MA</p>
        </div>
        <span class="cv-date">Aug – Dec 2021</span>
      </div>
      <ul>
        <li>Calculus 1 tutoring: study plans, homework help, exam preparation.</li>
      </ul>
    </div>
  </section>

  <!-- ── Outreach ──────────────────────────────────────── -->
  <section class="cv-section">
    <h2 class="cv-heading">Outreach & Service</h2>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Communications Officer</h3>
          <p class="cv-org">Quantum Information Science and Technology Initiative (QuIST), UC Davis</p>
        </div>
        <span class="cv-date">Aug 2025 – Present</span>
      </div>
      <ul>
        <li>Organize external speaker events; manage live-streaming, recording, and YouTube posting. Maintain QuIST website.</li>
      </ul>
    </div>

    <div class="cv-entry">
      <div class="cv-entry-header">
        <div>
          <h3>Graduate Student Mentor</h3>
          <p class="cv-org">Quantum Computing at Davis Club, UC Davis</p>
        </div>
        <span class="cv-date">Nov 2025 – Present</span>
      </div>
      <ul>
        <li>Mentor for quantum hardware journal club (~twice monthly).</li>
      </ul>
    </div>
  </section>

  <!-- ── Awards ────────────────────────────────────────── -->
  <section class="cv-section">
    <h2 class="cv-heading">Awards & Honors</h2>
    <ul class="awards-list">
      <li>
        <span class="award-year">2023</span>
        Departmental Honors in Physics, <em>summa cum laude</em>, Gordon College
      </li>
      <li>
        <span class="award-year">2022</span>
        Jerrold L. McNatt Physics Scholarship, Gordon College
      </li>
      <li>
        <span class="award-year">2021–22</span>
        Scholarships for Military Children, Fisher House Foundation
      </li>
      <li>
        <span class="award-year">2021</span>
        Chief Petty Officer Scholarship, Chief Petty Officer Scholarship Fund
      </li>
      <li>
        <span class="award-year">2021</span>
        Donna and Raymond Densmore Scholarship, Stonington High School
      </li>
    </ul>
  </section>
</PageLayout>

<style>
  .cv-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cv-name {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-heading);
    margin: 0 0 0.5rem;
  }

  .cv-contact {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.5rem;
    align-items: center;
  }

  .dot {
    color: var(--color-border);
  }

  .dl-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .dl-btn:hover {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  /* Sections */
  .cv-section {
    margin-bottom: 2.5rem;
  }

  .cv-heading {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    font-weight: 600;
    margin: 0 0 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* Entries */
  .cv-entry {
    margin-bottom: 1.75rem;
  }

  .cv-entry-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }

  .cv-entry h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-heading);
    margin: 0;
    line-height: 1.4;
  }

  .minor {
    font-weight: 400;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .cv-org {
    font-size: 0.82rem;
    color: var(--color-muted);
    margin: 0.2rem 0 0;
  }

  .cv-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
    flex-shrink: 0;
  }

  .cv-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .cv-gpa {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .cv-detail {
    font-size: 0.85rem;
    color: var(--color-text);
    margin: 0.2rem 0 0;
  }

  .cv-entry ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .cv-entry ul li {
    font-size: 0.875rem;
    color: var(--color-text);
    padding-left: 1.25rem;
    position: relative;
    line-height: 1.6;
  }

  .cv-entry ul li::before {
    content: "▸";
    color: var(--color-accent);
    position: absolute;
    left: 0;
  }

  /* Publications */
  .pub-list {
    padding-left: 1.75rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pub-list li {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.65;
  }

  .pub-list li::marker {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  /* Awards */
  .awards-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .awards-list li {
    display: flex;
    gap: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-text);
    align-items: baseline;
  }

  .award-year {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-accent);
    white-space: nowrap;
    width: 4rem;
    flex-shrink: 0;
  }

  @media (max-width: 520px) {
    .cv-entry-header {
      flex-direction: column;
    }

    .cv-right {
      align-items: flex-start;
      flex-direction: row;
      gap: 0.75rem;
    }
  }
</style>
