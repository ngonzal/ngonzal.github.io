---
import "@/styles/global.css";

interface Props {
  meta: {
    title: string;
    description?: string;
  };
}

const { meta } = Astro.props;
const siteOwner = "Nathan R. González";
const pageTitle =
  meta.title === "Home" ? siteOwner : `${meta.title} · ${siteOwner}`;

const navLinks = [
  { href: "/", label: "home" },
  { href: "/research", label: "research" },
  { href: "/teaching", label: "teaching" },
  { href: "/cv", label: "cv" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {meta.description && <meta name="description" content={meta.description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="site-wrapper">
      <header>
        <nav>
          <a href="/" class="site-brand">
            <span class="tilde">~</span>nathanrgonzalez
          </a>
          <ul class="nav-links">
            {
              navLinks.map(({ href, label }) => {
                const isActive =
                  href === "/"
                    ? path === "/"
                    : path === href || path.startsWith(href + "/");
                return (
                  <li>
                    <a href={href} class={"nav-link" + (isActive ? " active" : "")}>
                      {label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
        <hr class="divider" />
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <hr class="divider" />
        <div class="footer-inner">
          <span>{siteOwner} · UC Davis Physics</span>
          <div class="footer-links">
            <a href="mailto:nrgonz@ucdavis.edu">Email</a>
            <a
              href="https://www.linkedin.com/in/nathanrgonzalez"
              target="_blank"
              rel="noopener noreferrer">LinkedIn</a
            >
            <a
              href="https://arxiv.org/search/?searchtype=author&query=gonzalez+n+r"
              target="_blank"
              rel="noopener noreferrer">arXiv</a
            >
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .site-wrapper {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 1.5rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  header {
    padding-top: 2rem;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .site-brand {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-heading);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .site-brand:hover {
    color: var(--color-accent);
  }

  .tilde {
    color: var(--color-accent);
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 1rem 0 0;
  }

  main {
    flex: 1;
    padding: 3rem 0 4rem;
  }

  footer .divider {
    margin: 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1.25rem 0 2rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
  }

  .footer-links a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 520px) {
    nav {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-inner {
      flex-direction: column;
    }
  }
</style>
